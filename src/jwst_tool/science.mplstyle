# Serif style for the scientific-plotting skill.

figure.figsize : 8, 6
figure.dpi : 100
savefig.dpi : 100
savefig.bbox : tight

font.size : 12
font.family : serif
font.serif : Times New Roman, Palatino, DejaVu Serif, serif

axes.linewidth : 1.5
axes.labelsize : large
axes.labelpad : 5
axes.titlepad : 5
axes.axisbelow : False
axes.xmargin : 0
axes.ymargin : 0.1
axes.formatter.limits : -6, 6
axes.formatter.use_mathtext : True
mathtext.fontset : stix
axes.formatter.useoffset : False
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', 'CC79A7', '56B4E9'])

xtick.direction : in
xtick.top : True
xtick.minor.visible : True
xtick.labelsize : large
xtick.major.size : 8
xtick.major.width : 1.3
xtick.minor.size : 4
xtick.minor.width : 1
xtick.major.pad : 6
ytick.direction : in
ytick.right : True
ytick.minor.visible : True
ytick.labelsize : large
ytick.major.size : 8
ytick.major.width : 1.3
ytick.minor.size : 4
ytick.minor.width : 1
ytick.major.pad : 6

grid.color : k
grid.linestyle : :
grid.linewidth : 0.5
legend.frameon : False
legend.borderaxespad : 1
legend.fontsize : 10
legend.handlelength : 1.5
legend.labelspacing : 0.3
lines.markersize : 8
patch.force_edgecolor : True
patch.edgecolor : k
errorbar.capsize : 3
image.cmap : cividis
image.interpolation : bilinear
