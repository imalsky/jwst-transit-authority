# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store

# Generated caches (model spectra + pandeia results) -- regenerated per run
output/*
!output/.gitkeep

# Editor / OS noise
.vscode/
.idea/

# Packaging build artifacts
*.egg-info/
build/
dist/

# Large synphot reference data (fetch from ssb.stsci.edu/trds; worker preflight guides you)
data/cdbs/calspec/

# Large pandeia reference data (~4.3 GB per release; `jwst-tool data` reports
# status). Globbed, not per-release, so a new release's triple is ignored
# too and never one `git add -A` away from the history.
data/pandeia_data-*/
data/pandeia_psfs-*/
# Local working documents, not part of the package.
CLAUDE.md
/notes.md
/todo.md

# Machine-local PHOENIX stellar grid (~1.9 GB). Consumers obtain it via
# `jwst-tool fetch`; `jwst-tool data` reports status.
data/cdbs/grid/phoenix


# C/O survey archive (its report carries personal paths)
validation/co_limits/
validation/co_stall/
